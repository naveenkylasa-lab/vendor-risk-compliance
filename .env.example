# Execution Mode: "auto" (uses live LLM if API key is set, otherwise realistic simulation), "live", or "simulation"
EXECUTION_MODE=auto
ENVIRONMENT=production

# Preferred LLM Provider when in live/auto mode: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (loaded as SecretStr via env or GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key)
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# OpenAI API Key (loaded as SecretStr via env or OPENAI_API_KEY_FILE=/run/secrets/openai_api_key)
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_PRO_MODEL=gpt-4o

# OpenTelemetry Distributed Tracing & Structured Logging (structlog)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=vendor-risk-compliance-multi-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# Async SQLite Memory Store
SQLITE_DB_PATH=./vendor_sessions.db

# Server Configuration
PORT=8000
HOST=127.0.0.1
