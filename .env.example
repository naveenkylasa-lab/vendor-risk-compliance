# Execution Mode: "auto" (uses live LLM if API key is set, otherwise realistic simulation), "live", or "simulation"
EXECUTION_MODE=auto

# Preferred LLM Provider when in live/auto mode: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (optional - falls back to simulation mode if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (optional - falls back to simulation mode if omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server Configuration
PORT=8000
HOST=127.0.0.1
