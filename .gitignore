# Environment & Secret files (never commit real keys)
.env
.env.*
!.env.example
secrets/

# Python bytecode & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Local SQLite databases & WAL files
*.db
*.db-shm
*.db-wal

# Terraform state & provider caches
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/tfplan
